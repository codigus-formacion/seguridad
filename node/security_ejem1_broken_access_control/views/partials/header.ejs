<!DOCTYPE html>
<html lang="es">
<head>
  <title>Post App</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style> body { background-color: #f8f9fa; } </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand fw-bold" href="/">&#128209; Post App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <% if (!logged) { %>
        <form action="/login" method="post" class="d-flex ms-auto gap-2 align-items-center">
          <input type="text" name="username" placeholder="Username" class="form-control form-control-sm">
          <input type="password" name="password" placeholder="Password" class="form-control form-control-sm">
          <button type="submit" class="btn btn-sm btn-primary">Sign In</button>
        </form>
        <% } else { %>
        <ul class="navbar-nav ms-auto align-items-center gap-2">
          <li><span class="text-white">&#128100; <%= userName %></span></li>
          <li>
            <form action="/logout" method="post">
              <button type="submit" class="btn btn-sm btn-outline-light">Log Out</button>
            </form>
          </li>
        </ul>
        <% } %>
      </div>
    </div>
  </nav>
  <div class="container mt-4">
